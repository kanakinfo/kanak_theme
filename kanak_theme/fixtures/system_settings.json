[{
    "doctype": "Custom Field",
    "dt": "System Settings",
    "module": "Kanak Theme",
    "name": "System Settings-themesettings_tab",
    "fieldname": "themesettings_tab",
    "fieldtype": "Tab Break",
    "label": "Theme Settings",
    "insert_after": "encrypt_backup"
},
{
    "doctype": "Custom Field",
    "dt": "System Settings",
    "module": "Kanak Theme",
    "name":"System Settings-enable_announcement",
    "fieldname": "enable_announcement",
    "fieldtype": "Check",
    "label": "Enable Announcement",
    "insert_after": "themesettings_tab"
},
{
 "doctype": "Custom Field",
 "dt": "System Settings",
 "module": "Kanak Theme",
 "name":"System Settings-announcement_text",
 "fieldname": "announcement_text",
 "fieldtype": "Text Editor",
 "label": "Announcement Text",
 "insert_after": "enable_announcement",
 "depends_on": "eval:doc.enable_announcement"
},
{
    "doctype": "Custom Field",
    "dt": "System Settings",
    "module": "Kanak Theme",
    "name": "System Settings-mq_scrollamount",
    "fieldname": "mq_scrollamount",
    "fieldtype": "Int",
    "label": "Scroll Amount",
    "default": "6",
    "description": "Amount of scrolling per movement in pixels. Higher value = faster speed.",
    "insert_after": "announcement_text",
    "depends_on": "eval:doc.enable_announcement"
  },
  {
    "doctype": "Custom Field",
    "dt": "System Settings",
    "module": "Kanak Theme",
    "name": "System Settings-mq_behavior",
    "fieldname": "mq_behavior",
    "fieldtype": "Select",
    "label": "Scroll Behavior",
    "options": "scroll\nslide\nalternate",
    "default": "scroll",
    "description": "Defines how the marquee moves.",
    "insert_after": "mq_scrollamount",
    "depends_on": "eval:doc.enable_announcement"
  },
  {
    "doctype": "Custom Field",
    "dt": "System Settings",
    "module": "Kanak Theme",
    "name": "System Settings-mq_direction",
    "fieldname": "mq_direction",
    "fieldtype": "Select",
    "label": "Scroll Direction",
    "options": "left\nright\nup\ndown",
    "default": "left",
    "description": "Direction of marquee scrolling.",
    "insert_after": "mq_behavior",
    "depends_on": "eval:doc.enable_announcement"
  },
  {
    "doctype": "Custom Field",
    "dt": "System Settings",
    "module": "Kanak Theme",
    "name": "System Settings-mq_scrolldelay",
    "fieldname": "mq_scrolldelay",
    "fieldtype": "Int",
    "label": "Scroll Delay (ms)",
    "default": "0",
    "description": "Delay between each movement in milliseconds.",
    "insert_after": "mq_direction",
    "depends_on": "eval:doc.enable_announcement"
  },
  {
    "doctype": "Custom Field",
    "dt": "System Settings",
    "module": "Kanak Theme",
    "name": "System Settings-mq_bgcolor",
    "fieldname": "mq_bgcolor",
    "fieldtype": "Color",
    "label": "Marquee Background Color",
    "default": "#ffffff",
    "description": "Background color of the marquee area.",
    "insert_after": "mq_scrolldelay",
    "depends_on": "eval:doc.enable_announcement"
  }
]